def numbers_in(obj):
    """Every number inside a spec (for tracing text back to computed values)."""
    out = []
    if isinstance(obj, bool):
        return out
    if isinstance(obj, (int, float)):
        out.append(float(obj))
    elif isinstance(obj, dict):
