{"scenarios": [
  {"name": "adds 18% GST", "steps": [{"fill": "#amount", "value": "1000"}, {"click": "#calc"}, {"expect_text": "#total", "contains": "1,180.00"}, {"expect_text": "#breakup", "contains": "180.00"}]},
  {"name": "other rates", "steps": [{"fill": "#amount", "value": "200"}, {"select": "#rate", "value": "0.05"}, {"click": "#calc"}, {"expect_text": "#total", "contains": "210.00"}]},
  {"name": "history survives a reload and can be cleared", "steps": [{"fill": "#amount", "value": "100"}, {"click": "#calc"}, {"fill": "#amount", "value": "50"}, {"press": "#amount", "key": "Enter"},
     {"reload": true}, {"expect_count": "#history li", "count": 2}, {"click": "#clear"}, {"expect_count": "#history li", "count": 0}]},
  {"name": "rejects a negative amount", "steps": [{"fill": "#amount", "value": "-5"}, {"click": "#calc"}, {"expect_text": "#total", "equals": "₹0.00"}]}
]}
